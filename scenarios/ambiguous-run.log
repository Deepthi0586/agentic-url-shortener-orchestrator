      "content": "package com.saigangili.shortener.model;\n\nimport jakarta.persistence.CollectionTable;\nimport jakarta.persistence.Column;\nimport jakarta.persistence.ElementCollection;\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.GeneratedValue;\nimport jakarta.persistence.GenerationType;\nimport jakarta.persistence.Id;\nimport jakarta.persistence.Lob;\nimport jakarta.persistence.Table;\nimport java.time.Instant;\nimport java.util.ArrayList;\nimport java.util.List;\n\n// Core reporting entity. MetricDefinition and AnalyticsSnapshot are referenced\n// by id (configuredMetrics) rather than modeled as separate JPA entities in\n// this pass, since the create/retrieve flow for reports is the core scope.\n// UserDashboardPreference, caching, and analytics-event ingestion are out of\n// scope for this generation (see service-layer comments).\n@Entity\n@Table(name = \"reports\")\npublic class Report {\n\n    @Id\n    @GeneratedValue(strategy = GenerationType.UUID)\n    private String id;\n\n    @Column(nullable = false)\n    private String name;\n\n    @Column(nullable = false)\n    private String ownerId;\n\n    @ElementCollection\n    @CollectionTable(name = \"report_configured_metrics\", joinColumns = @jakarta.persistence.JoinColumn(name = \"report_id\"))\n    @Column(name = \"metric_id\")\n    private List<String> configuredMetrics = new ArrayList<>();\n\n    // Filters stored as a JSON string blob to keep the model generic,\n    // matching the \"fields intentionally generic\" note in the design.\n    @Lob\n    private String filters;\n\n    @Column(nullable = false)\n    private String visualizationType;\n\n    @Column(nullable = false)\n    private Instant createdAt;\n\n    @Column(nullable = false)\n    private Instant updatedAt;\n\n    protected Report() {\n        // JPA\n    }\n\n    public Report(String name, String ownerId, List<String> configuredMetrics,\n                   String filters, String visualizationType) {\n        this.name = name;\n        this.ownerId = ownerId;\n        this.configuredMetrics = configuredMetrics != null ? configuredMetrics : new ArrayList<>();\n        this.filters = filters;\n        this.visualizationType = visualizationType;\n        Instant now = Instant.now();\n        this.createdAt = now;\n        this.updatedAt = now;\n    }\n\n    public String getId() {\n        return id;\n    }\n\n    public String getName() {\n        return name;\n    }\n\n    public void setName(String name) {\n        this.name = name;\n        touch();\n    }\n\n    public String getOwnerId() {\n        return ownerId;\n    }\n\n    public List<String> getConfiguredMetrics() {\n        return configuredMetrics;\n    }\n\n    public void setConfiguredMetrics(List<String> configuredMetrics) {\n        this.configuredMetrics = configuredMetrics;\n        touch();\n    }\n\n    public String getFilters() {\n        return filters;\n    }\n\n    public void setFilters(String filters) {\n        this.filters = filters;\n        touch();\n    }\n\n    public String getVisualizationType() {\n        return visualizationType;\n    }\n\n    public void setVisualizationType(String visualizationType) {\n        this.visualizationType = visualizationType;\n        touch();\n    }\n\n    public Instant getCreatedAt() {\n        return createdAt;\n    }\n\n    public Instant getUpdatedAt() {\n        return updatedAt;\n    }\n\n    private void touch() {\n        this.updatedAt = Instant.now();\n    }\n}\n"
