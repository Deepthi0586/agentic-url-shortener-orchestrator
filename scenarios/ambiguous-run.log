      "content": "package com.saigangili.shortener.controller;\n\nimport com.saigangili.shortener.model.Report;\nimport com.saigangili.shortener.service.ReportService;\nimport org.springframework.data.domain.Page;\nimport org.springframework.data.domain.PageRequest;\nimport org.springframework.data.domain.Pageable;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.web.bind.annotation.ExceptionHandler;\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PathVariable;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestParam;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport java.time.Instant;\nimport java.util.List;\nimport java.util.Map;\n\n// NOTE: /api/v1/analytics/summary and /api/v1/analytics/metrics endpoints\n// (aggregated key metrics, available metric/dimension definitions) depend on\n// MetricDefinition/AnalyticsSnapshot aggregation logic which is out of scope\n// for this pass. Only Report create/retrieve is implemented below, exposed\n// under /api/v1/analytics/reports as the closest analog to the requested\n// create/retrieve/redirect flow.\n\n@RestController\npublic class AnalyticsController {\n\n    private final ReportService reportService;\n\n    public AnalyticsController(ReportService reportService) {\n        this.reportService = reportService;\n    }\n\n    @PostMapping(\"/api/v1/analytics/reports\")\n    public ResponseEntity<Map<String, Object>> createReport(@RequestBody CreateReportRequest request) {\n        Report report = reportService.createReport(\n                request.name(),\n                request.ownerId(),\n                request.configuredMetrics(),\n                request.filters(),\n                request.visualizationType());\n        return ResponseEntity.status(HttpStatus.CREATED).body(envelope(report));\n    }\n\n    @GetMapping(\"/api/v1/analytics/reports/{reportId}\")\n    public ResponseEntity<Map<String, Object>> getReport(@PathVariable Long reportId) {\n        Report report = reportService.getReportById(reportId);\n        return ResponseEntity.ok(envelope(report));\n    }\n\n    @GetMapping(\"/api/v1/analytics/reports\")\n    public ResponseEntity<Map<String, Object>> listReports(\n            @RequestParam(required = false) String ownerId,\n            @RequestParam(defaultValue = \"0\") int page,\n            @RequestParam(defaultValue = \"20\") int size) {\n        Pageable pageable = PageRequest.of(page, size);\n        Page<Report> reports = reportService.listReports(ownerId, pageable);\n        return ResponseEntity.ok(envelope(reports));\n    }\n\n    @ExceptionHandler(ReportService.ReportNotFoundException.class)\n    public ResponseEntity<Map<String, Object>> handleNotFound(ReportService.ReportNotFoundException ex) {\n        Map<String, Object> body = Map.of(\n                \"error\", ex.getMessage(),\n                \"meta\", metadata());\n        return ResponseEntity.status(HttpStatus.NOT_FOUND).body(body);\n    }\n\n    private Map<String, Object> envelope(Report report) {\n        return Map.of(\n                \"data\", report,\n                \"meta\", metadata());\n    }\n\n    private Map<String, Object> envelope(Page<Report> page) {\n        return Map.of(\n                \"data\", page.getContent(),\n                \"pagination\", Map.of(\n                        \"page\", page.getNumber(),\n                        \"size\", page.getSize(),\n                        \"totalElements\", page.getTotalElements(),\n                        \"totalPages\", page.getTotalPages()),\n                \"meta\", metadata());\n    }\n\n    private Map<String, Object> metadata() {\n        return Map.of(\n                \"lastUpdated\", Instant.now().toString(),\n                \"dataFreshness\", \"real-time\");\n    }\n\n    public record CreateReportRequest(\n            String name,\n            String ownerId,\n            List<String> configuredMetrics,\n            Map<String, String> filters,\n            String visualizationType) {\n    }\n}\n"
