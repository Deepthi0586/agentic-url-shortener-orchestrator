      "content": "package com.saigangili.shortener.controller;\n\nimport com.saigangili.shortener.model.Report;\nimport com.saigangili.shortener.service.AnalyticsService;\nimport org.springframework.data.domain.Page;\nimport org.springframework.data.domain.PageRequest;\nimport org.springframework.data.domain.Pageable;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PathVariable;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestParam;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport java.time.Instant;\nimport java.util.LinkedHashMap;\nimport java.util.List;\nimport java.util.Map;\n\n// Exposes the versioned analytics endpoints described in the design.\n// Responses are wrapped in a consistent envelope with metadata\n// (lastUpdated, dataFreshness) per the API contract. Rate limiting and\n// response caching (e.g., ETag/short-TTL cache headers) are not\n// implemented here per scope constraints.\n@RestController\npublic class AnalyticsController {\n\n    private final AnalyticsService analyticsService;\n\n    public AnalyticsController(AnalyticsService analyticsService) {\n        this.analyticsService = analyticsService;\n    }\n\n    @GetMapping(\"/api/v1/analytics/summary\")\n    public ResponseEntity<Map<String, Object>> getSummary(\n            @RequestParam(required = false) Instant from,\n            @RequestParam(required = false) Instant to,\n            @RequestParam(required = false) String segment) {\n        Map<String, Object> summary = analyticsService.getSummary(from, to, segment);\n        return ResponseEntity.ok(envelope(summary));\n    }\n\n    @GetMapping(\"/api/v1/analytics/metrics\")\n    public ResponseEntity<Map<String, Object>> listMetrics() {\n        List<Map<String, String>> metrics = analyticsService.listAvailableMetrics();\n        return ResponseEntity.ok(envelope(Map.of(\"metrics\", metrics)));\n    }\n\n    // Report creation isn't explicitly in the API contract's read endpoints,\n    // but is required to support the \"create/retrieve\" core flow requested.\n    @PostMapping(\"/api/v1/analytics/reports\")\n    public ResponseEntity<Map<String, Object>> createReport(@RequestBody CreateReportRequest request) {\n        Report report = analyticsService.createReport(\n                request.name(), request.ownerId(), request.configuredMetrics(),\n                request.filters(), request.visualizationType());\n        return ResponseEntity.status(HttpStatus.CREATED).body(envelope(toMap(report)));\n    }\n\n    @GetMapping(\"/api/v1/analytics/reports/{reportId}\")\n    public ResponseEntity<Map<String, Object>> getReport(\n            @PathVariable String reportId,\n            @RequestParam(required = false) Instant from,\n            @RequestParam(required = false) Instant to,\n            @RequestParam(required = false) String segment) {\n        Report report = analyticsService.getReport(reportId);\n        Map<String, Object> body = new LinkedHashMap<>(toMap(report));\n        body.put(\"filterRangeStart\", from);\n        body.put(\"filterRangeEnd\", to);\n        body.put(\"segment\", segment);\n        return ResponseEntity.ok(envelope(body));\n    }\n\n    @GetMapping(\"/api/v1/analytics/reports\")\n    public ResponseEntity<Map<String, Object>> listReports(\n            @RequestParam String ownerId,\n            @RequestParam(defaultValue = \"0\") int page,\n            @RequestParam(defaultValue = \"20\") int size) {\n        Pageable pageable = PageRequest.of(page, size);\n        Page<Report> reports = analyticsService.listReportsByOwner(ownerId, pageable);\n        Map<String, Object> body = Map.of(\n                \"content\", reports.getContent(),\n                \"page\", reports.getNumber(),\n                \"size\", reports.getSize(),\n                \"totalElements\", reports.getTotalElements(),\n                \"totalPages\", reports.getTotalPages()\n        );\n        return ResponseEntity.ok(envelope(body));\n    }\n\n    private Map<String, Object> toMap(Report report) {\n        Map<String, Object> map = new LinkedHashMap<>();\n        map.put(\"id\", report.getId());\n        map.put(\"name\", report.getName());\n        map.put(\"ownerId\", report.getOwnerId());\n        map.put(\"configuredMetrics\", report.getConfiguredMetrics());\n        map.put(\"filters\", report.getFilters());\n        map.put(\"visualizationType\", report.getVisualizationType());\n        map.put(\"createdAt\", report.getCreatedAt());\n        map.put(\"updatedAt\", report.getUpdatedAt());\n        return map;\n    }\n\n    private Map<String, Object> envelope(Object data) {\n        Map<String, Object> meta = Map.of(\n                \"lastUpdated\", Instant.now(),\n                \"dataFreshness\", \"live\"\n        );\n        Map<String, Object> envelope = new LinkedHashMap<>();\n        envelope.put(\"data\", data);\n        envelope.put(\"meta\", meta);\n        return envelope;\n    }\n\n    public record CreateReportRequest(\n            String name,\n            String ownerId,\n            List<String> configuredMetrics,\n            String filters,\n            String visualizationType\n    ) {\n    }\n}\n"
    }
