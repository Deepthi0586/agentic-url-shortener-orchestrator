      "content": "package com.saigangili.shortener.controller;\n\nimport com.saigangili.shortener.model.AnalyticsSnapshot;\nimport com.saigangili.shortener.model.Report;\nimport com.saigangili.shortener.service.AnalyticsService;\nimport com.saigangili.shortener.service.AnalyticsService.ReportData;\nimport com.saigangili.shortener.service.AnalyticsService.ReportNotFoundException;\nimport java.time.Instant;\nimport java.util.List;\nimport java.util.Map;\nimport org.springframework.data.domain.Page;\nimport org.springframework.data.domain.PageRequest;\nimport org.springframework.data.domain.Pageable;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PathVariable;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestParam;\nimport org.springframework.web.bind.annotation.RestController;\n\n/**\n * Versioned analytics API. Endpoints return a consistent envelope with\n * `data` and `meta` (lastUpdated, dataFreshness) as required by the design.\n *\n * Note: /metrics (available metrics/dimensions listing) requires a\n * MetricDefinition repository/service which is out of scope for this pass\n * and is therefore not implemented here.\n */\n@RestController\npublic class AnalyticsController {\n\n    private final AnalyticsService analyticsService;\n\n    public AnalyticsController(AnalyticsService analyticsService) {\n        this.analyticsService = analyticsService;\n    }\n\n    @PostMapping(\"/api/v1/reports\")\n    public ResponseEntity<Envelope<Report>> createReport(@RequestBody Report report) {\n        Report created = analyticsService.createReport(report);\n        return ResponseEntity.status(HttpStatus.CREATED).body(Envelope.of(created));\n    }\n\n    @GetMapping(\"/api/v1/analytics/reports/{reportId}\")\n    public ResponseEntity<Envelope<ReportData>> getReport(\n            @PathVariable Long reportId,\n            @RequestParam(required = false) Instant from,\n            @RequestParam(required = false) Instant to) {\n        Instant effectiveFrom = from != null ? from : Instant.EPOCH;\n        Instant effectiveTo = to != null ? to : Instant.now();\n        try {\n            ReportData data = analyticsService.getReportData(reportId, effectiveFrom, effectiveTo);\n            return ResponseEntity.ok(Envelope.of(data));\n        } catch (ReportNotFoundException ex) {\n            return ResponseEntity.notFound().build();\n        }\n    }\n\n    @GetMapping(\"/api/v1/reports\")\n    public ResponseEntity<Envelope<Page<Report>>> listReports(\n            @RequestParam String ownerId,\n            @RequestParam(defaultValue = \"0\") int page,\n            @RequestParam(defaultValue = \"20\") int size) {\n        Pageable pageable = PageRequest.of(page, size);\n        Page<Report> reports = analyticsService.listReportsForOwner(ownerId, pageable);\n        return ResponseEntity.ok(Envelope.of(reports));\n    }\n\n    @GetMapping(\"/api/v1/analytics/summary\")\n    public ResponseEntity<Envelope<Map<String, Double>>> getSummary(\n            @RequestParam List<String> metricIds,\n            @RequestParam(required = false) Instant from,\n            @RequestParam(required = false) Instant to) {\n        Instant effectiveFrom = from != null ? from : Instant.EPOCH;\n        Instant effectiveTo = to != null ? to : Instant.now();\n        Map<String, Double> summary = analyticsService.getSummary(metricIds, effectiveFrom, effectiveTo);\n        return ResponseEntity.ok(Envelope.of(summary));\n    }\n\n    /**\n     * Generic response envelope with metadata to support freshness/accuracy\n     * expectations from the design.\n     */\n    static class Envelope<T> {\n        public T data;\n        public Meta meta;\n\n        static <T> Envelope<T> of(T data) {\n            Envelope<T> env = new Envelope<>();\n            env.data = data;\n            env.meta = new Meta(Instant.now(), \"live\");\n            return env;\n        }\n    }\n\n    static class Meta {\n        public Instant lastUpdated;\n        public String dataFreshness;\n\n        Meta(Instant lastUpdated, String dataFreshness) {\n            this.lastUpdated = lastUpdated;\n            this.dataFreshness = dataFreshness;\n        }\n    }\n}\n"
    }
