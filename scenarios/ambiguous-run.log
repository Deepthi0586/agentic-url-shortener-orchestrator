      "path": "service/AnalyticsService.java",
      "content": "package com.saigangili.shortener.service;\n\nimport com.saigangili.shortener.model.AnalyticsSnapshot;\nimport com.saigangili.shortener.model.Report;\nimport com.saigangili.shortener.repository.AnalyticsSnapshotRepository;\nimport com.saigangili.shortener.repository.ReportRepository;\nimport java.time.Instant;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.stream.Collectors;\nimport org.springframework.data.domain.Page;\nimport org.springframework.data.domain.Pageable;\nimport org.springframework.stereotype.Service;\n\n/**\n * Core service for creating/retrieving reports and computing basic\n * aggregated summaries over analytics snapshots.\n *\n * Out of scope for this pass (noted per design, not implemented here):\n *  - Time-boxed caching of aggregated snapshot queries with invalidation\n *    on new data ingestion.\n *  - Full analytics event ingestion/storage pipeline.\n *  - Rate limiting on API access.\n *  - Advanced report aggregation/reporting engines (this service exposes\n *    only a minimal average-value summary as a placeholder).\n */\n@Service\npublic class AnalyticsService {\n\n    private final ReportRepository reportRepository;\n    private final AnalyticsSnapshotRepository snapshotRepository;\n\n    public AnalyticsService(ReportRepository reportRepository,\n                             AnalyticsSnapshotRepository snapshotRepository) {\n        this.reportRepository = reportRepository;\n        this.snapshotRepository = snapshotRepository;\n    }\n\n    public Report createReport(Report report) {\n        return reportRepository.save(report);\n    }\n\n    public Report getReport(Long reportId) {\n        return reportRepository.findById(reportId)\n                .orElseThrow(() -> new ReportNotFoundException(reportId));\n    }\n\n    public Page<Report> listReportsForOwner(String ownerId, Pageable pageable) {\n        return reportRepository.findByOwnerId(ownerId, pageable);\n    }\n\n    /**\n     * Builds a detailed data view for a report: the report configuration plus\n     * the raw snapshots for its configured metrics within the given date range.\n     * Real aggregation/visualization logic is deferred (out of scope).\n     */\n    public ReportData getReportData(Long reportId, Instant from, Instant to) {\n        Report report = getReport(reportId);\n        List<AnalyticsSnapshot> snapshots = snapshotRepository\n                .findByMetricIdInAndTimestampBetween(report.getConfiguredMetrics(), from, to);\n        return new ReportData(report, snapshots);\n    }\n\n    /**\n     * Minimal aggregated summary: average value per metric across the given\n     * date range. This is a placeholder for the \"aggregated key metrics\"\n     * summary endpoint; deeper aggregation/reporting is out of scope.\n     */\n    public Map<String, Double> getSummary(List<String> metricIds, Instant from, Instant to) {\n        List<AnalyticsSnapshot> snapshots =\n                snapshotRepository.findByMetricIdInAndTimestampBetween(metricIds, from, to);\n        return snapshots.stream()\n                .collect(Collectors.groupingBy(\n                        AnalyticsSnapshot::getMetricId,\n                        Collectors.averagingDouble(AnalyticsSnapshot::getValue)));\n    }\n\n    public static class ReportNotFoundException extends RuntimeException {\n        public ReportNotFoundException(Long reportId) {\n            super(\"Report not found: \" + reportId);\n        }\n    }\n\n    public static class ReportData {\n        private final Report report;\n        private final List<AnalyticsSnapshot> snapshots;\n\n        public ReportData(Report report, List<AnalyticsSnapshot> snapshots) {\n            this.report = report;\n            this.snapshots = snapshots;\n        }\n\n        public Report getReport() {\n            return report;\n        }\n\n        public List<AnalyticsSnapshot> getSnapshots() {\n            return snapshots;\n        }\n    }\n}\n"
